{
  "name": "wake-word-detector",
  "version": "1.0.0",
  "description": "Wake word detection for 'hey claude' to open WSL terminals",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && cross-env NODE_ENV=development electron dist/main/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc src/main/main.ts --outDir dist/main --module commonjs --target es2020 && tsc src/main/preload.ts --outDir dist/main --module commonjs --target es2020",
    "start": "electron dist/main/main.js",
    "preview": "vite preview",
    "build-installer": "npm run build && electron-builder",
    "build-installer-win": "npm run build && electron-builder --win",
    "build-installer-win-x64": "npm run build && electron-builder --win --x64",
    "build-installer-win-ia32": "npm run build && electron-builder --win --ia32",
    "build-portable": "npm run build && electron-builder --win --config.win.target=portable",
    "build-msi": "npm run build && electron-builder --win --config.win.target=msi",
    "build-all": "npm run build && electron-builder --win --x64 --ia32",
    "dist": "npm run build-installer-win",
    "package": "npm run build && npm run package-files",
    "package-files": "powershell -Command \"Compress-Archive -Path dist/main,dist/renderer,keywords,assets,node_modules,package.json -DestinationPath release/Claude-Wake-Word-Detector-Portable.zip -Force\"",
    "clean": "rimraf dist release",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "wake-word",
    "voice",
    "porcupine",
    "picovoice",
    "claude"
  ],
  "author": "Traves Theberge",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^2.7.11",
    "@picovoice/porcupine-node": "^3.0.6",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.23.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^20.19.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-vite": "^4.0.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  },
  "build": {
    "appId": "com.traves.claude-wake-word-detector",
    "productName": "Claude Wake Word Detector",
    "copyright": "Copyright © 2025 Traves Theberge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "keywords/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "keywords/",
        "to": "keywords/",
        "filter": ["**/*"]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app_small.ico",
      "publisherName": "Traves Theberge"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Wake Word Detector",
      "uninstallDisplayName": "Claude Wake Word Detector"
    }
  }
}
